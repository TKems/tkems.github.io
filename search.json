---
layout: null
sitemap: false
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | escape | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "category": {{ post.categories | join: ', ' | escape | jsonify }},
    "date": {{ post.date | date: "%B %e, %Y" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]